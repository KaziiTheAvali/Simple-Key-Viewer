{
	"schemaVersion": 1,
	"id": "simple-key-viewer",
	"version": "${version}",
	"name": "simple key viewer",
	"description": "This is the simple key viewer. displays what keys your pressing at the bottom!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/simple-input-viewer",
		"sources": "https://github.com/KaziiTheAvali/Simple-Key-Viewer"
	},
	"license": "MIT",
	"icon": "assets/simple-key-viewer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.kazii.SimpleKeyViewer"
		],
		"client": [
			"com.kazii.client.SimpleKeyViewerClient"
		],
		"fabric-datagen": [
			"com.kazii.client.SimpleKeyViewerDataGenerator"
		]
	},
	"mixins": [
		"simple-key-viewer.mixins.json",
		{
			"config": "simple-key-viewer.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*"
	}
}